<Window x:Class="GempaBMKG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GempaBMKG"
        mc:Ignorable="d"
        Title="Peringatan Gempa BMKG" Height="720" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Peringatan Gempa Indonesia" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,20" HorizontalAlignment="Center">
            <Button x:Name="BtnTerkini" Content="Gempa Terkini (M > 5.0)" Click="BtnTerkini_Click" Margin="0,0,10,0" Style="{StaticResource FluentButtonStyle}"/>
            <Button x:Name="BtnRealtime" Content="Gempa Realtime (Dirasakan)" Click="BtnRealtime_Click" Style="{StaticResource FluentButtonStyle}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Visibility="Collapsed" Width="100" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" FontSize="14"/>

            <ScrollViewer x:Name="MainContent" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentStackPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="FluentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
