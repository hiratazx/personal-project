<Window x:Class="GempaBMKG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GempaBMKG"
        mc:Ignorable="d"
        Title="InaTEWS BMKG - Peringatan Gempa Dini" Height="600" Width="850"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#FF202020">
    <Window.Resources>
        <Style x:Key="FluentNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2D2D2D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF3C3C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF2B2B2B" Padding="10">
            <StackPanel>
                <TextBlock Text="Menu Utama" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="10,15,10,15"/>
                           
                <Button x:Name="BtnRealtime" 
                        Content="Gempa Realtime" 
                        Style="{StaticResource FluentNavButtonStyle}"
                        Click="BtnRealtime_Click"/>
                        
                <Button x:Name="BtnTerkini" 
                        Content="Gempa Terkini" 
                        Style="{StaticResource FluentNavButtonStyle}"
                        Click="BtnTerkini_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ContentTitle" 
                       Text="Memuat data..." 
                       Grid.Row="0"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="30,25,30,15"/>

            <Border Grid.Row="1" Margin="30,0,30,30" CornerRadius="8" Background="#FF2B2B2B">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                    <TextBox x:Name="ContentTextBox"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="#E0E0E0"
                             FontSize="14"
                             FontFamily="Consolas"
                             BorderThickness="0"
                             Padding="15"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

